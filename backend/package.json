{
  "name": "zeere-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Zeere content, booking and QR validation backend",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:schema": "node database/run-sql.js schema",
    "db:init": "node database/migrate.js",
    "db:migrate": "node database/migrate.js",
    "db:seed": "node database/seed.js",
    "db:reset": "node database/run-sql.js reset",
    "create-admin": "node scripts/create-admin.js",
    "expire-qr": "node scripts/expire-qr-codes.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration.test.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.14.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": { "nodemon": "^3.1.10", "supertest": "^7.1.4" }
}
