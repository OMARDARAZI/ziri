<%- include('../partials/head') %><main class="container"><div class="qr-card card shadow-sm border-0"><div class="card-body text-center p-4"><div class="brand text-primary fs-4">ZEERA</div><p class="text-muted mb-3">Participant booking pass</p><span class="badge text-bg-<%= displayStatus==='ACTIVE'?'success':displayStatus==='USED'?'secondary':displayStatus==='NOT_YET_VALID'?'warning':'danger' %> mb-3"><%= displayStatus.replaceAll('_',' ') %></span><h1 class="h4"><%= record.participant_name %></h1><p class="text-muted"><%= maskedPhone %></p><img class="img-fluid rounded border mb-3" width="280" height="280" src="/qr/<%= record.public_token %>/image" alt="Participant QR code"><dl class="row text-start small mb-0"><dt class="col-5">Booking</dt><dd class="col-7"><%= record.booking_code %></dd><dt class="col-5">Offering</dt><dd class="col-7"><%= record.offering_title %></dd><dt class="col-5">Provider</dt><dd class="col-7"><%= record.provider_name %></dd><dt class="col-5">Scheduled</dt><dd class="col-7"><%= record.scheduled_at %></dd></dl><p class="small text-muted mt-3 mb-0">This page does not consume the QR code. Your provider validates it at check-in.</p></div></div></main><%- include('../partials/foot') %>
