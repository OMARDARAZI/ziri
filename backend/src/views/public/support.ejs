<%- include('../partials/head') %>
<main class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5">
        <div class="text-center mb-4">
          <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
            <i class="bi bi-headset fs-2"></i>
          </div>
          <h1 class="h3 fw-bold mb-1">Zeera Support & Contact</h1>
          <p class="text-muted small mb-0">Have a question or need help? Send us a message below.</p>
        </div>

        <% if (submitted) { %>
          <div class="alert alert-success border-0 rounded-3 p-4 text-center">
            <i class="bi bi-check-circle-fill fs-2 d-block text-success mb-2"></i>
            <h5 class="fw-bold mb-2">Thank you, <%= name %>!</h5>
            <p class="small text-secondary mb-0">
              Your support request has been received. Our team will review your inquiry and get back to you shortly.
            </p>
          </div>
          <div class="text-center mt-3">
            <a href="/privacy-policy" class="btn btn-outline-secondary btn-sm rounded-pill px-4">Back to Privacy Policy</a>
          </div>
        <% } else { %>
          <% if (error) { %>
            <div class="alert alert-danger border-0 rounded-3 p-3 mb-4 small"><%= error %></div>
          <% } %>

          <form method="post" action="/support">
            <div class="mb-3">
              <label class="form-label fw-bold small text-dark" for="name">Your Name <span class="text-danger">*</span></label>
              <input id="name" name="name" type="text" class="form-control py-2.5" placeholder="John Doe" required />
            </div>

            <div class="mb-3">
              <label class="form-label fw-bold small text-dark" for="email">Email Address</label>
              <input id="email" name="email" type="email" class="form-control py-2.5" placeholder="name@example.com" />
            </div>

            <div class="mb-3">
              <label class="form-label fw-bold small text-dark" for="phone">Phone Number</label>
              <input id="phone" name="phone" type="tel" class="form-control py-2.5" placeholder="+961 70 123 456" />
            </div>

            <div class="mb-3">
              <label class="form-label fw-bold small text-dark" for="subject">Subject <span class="text-danger">*</span></label>
              <input id="subject" name="subject" type="text" class="form-control py-2.5" placeholder="How can we help you?" required />
            </div>

            <div class="mb-4">
              <label class="form-label fw-bold small text-dark" for="message">Message <span class="text-danger">*</span></label>
              <textarea id="message" name="message" class="form-control py-2.5" rows="4" placeholder="Describe your question or issue in detail..." required></textarea>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2.5 rounded-3 fw-bold">
              Send Support Message
            </button>
          </form>

          <div class="text-center mt-4">
            <a href="/privacy-policy" class="text-decoration-none text-muted small">&larr; Back to Privacy Policy</a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/foot') %>
