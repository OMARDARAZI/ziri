<%- include('../partials/head') %><div class="container-fluid"><div class="row"><%- include('../partials/admin-nav') %><main class="col-md-9 col-lg-10 p-0 content-wrap"><%- include('../partials/web-top') %><div class="p-4"><%- include('../partials/alerts') %><h1 class="h3 mb-4">Dashboard</h1><div class="row g-3"><% const cards=[['Customers',summary.customers,'bi-people'],['Providers',summary.providers,'bi-shop'],['Offerings',summary.offerings,'bi-grid'],['Bookings',summary.bookings,'bi-calendar-check'],['Confirmed',summary.confirmed,'bi-check-circle'],['Cancelled',summary.cancelled,'bi-x-circle'],['QR validations today',summary.validations,'bi-qr-code-scan'],['Upcoming events',summary.events,'bi-calendar-event']]; cards.forEach(([label,value,icon])=>{ %><div class="col-sm-6 col-xl-3"><div class="card shadow-sm h-100"><div class="card-body"><i class="bi <%= icon %> text-primary fs-4"></i><div class="display-6 mt-2"><%= value %></div><div class="text-muted"><%= label %></div></div></div></div><% }) %></div></div></main></div></div><%- include('../partials/foot') %>
