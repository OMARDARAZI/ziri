<%- include('../partials/head') %><div class="container-fluid"><div class="row"><%- include('../partials/admin-nav') %><main class="col-md-9 col-lg-10 p-0 content-wrap"><%- include('../partials/web-top') %><div class="p-4"><h1 class="h3 mb-3"><%= title %></h1><form class="card shadow-sm" method="post" enctype="multipart/form-data" action="/admin/<%= resource %><%= item ? '/' + (item.id || item.setting_key) : '' %>"><div class="card-body"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row g-3"><% config.fields.forEach((field)=>{ const value=item?.[field] ?? ''; if(field==='password'&&item)return; %><div class="col-md-<%= ['content','description','address','setting_value','menu_items'].includes(field)?12:6 %>"><label class="form-label text-capitalize"><%= field.replaceAll('_',' ') %></label><% if(field==='content'||field==='description'||field==='address'||field==='setting_value'){ %><textarea class="form-control" rows="<%= field==='content'||field==='description'?5:2 %>" name="<%= field %>" <%= field==='setting_key'&&item?'readonly':'' %>><%= value %></textarea><% } else if(field==='menu_items'){ %><textarea class="form-control font-monospace" rows="8" name="menu_items" placeholder='[{"category":"Starters","name":"Dish Name","description":"Description","price":"$10.00"}]'><%= typeof value==='object'?JSON.stringify(value,null,2):value %></textarea><% } else if(field==='is_active'){ %><select class="form-select" name="is_active"><option value="1" <%= String(value)!=='0'?'selected':'' %>>Active</option><option value="0" <%= String(value)==='0'?'selected':'' %>>Inactive</option></select><% } else if(field==='type'){ %><select class="form-select" name="type"><option value="SERVICE" <%= value==='SERVICE'?'selected':'' %>>Service</option><option value="ACTIVITY" <%= value==='ACTIVITY'?'selected':'' %>>Activity</option></select><% } else if(field==='provider_id'){ %><select class="form-select" name="provider_id" required><option value="">Choose provider</option><% related.providers.forEach(p=>{ %><option value="<%= p.id %>" <%= Number(value)===p.id?'selected':'' %>><%= p.business_name %></option><% }) %></select><% } else if(field==='user_id'){ %><select class="form-select" name="user_id" required><option value="">Choose provider account</option><% related.providerUsers.forEach(u=>{ %><option value="<%= u.id %>" <%= Number(value)===u.id?'selected':'' %>><%= u.full_name %> — <%= u.phone %></option><% }) %></select><% } else { const type=field.includes('date')||field.endsWith('_at')||field==='story_time'||field==='weather_date'?'datetime-local':field.includes('price')||['temperature','humidity','wind_speed','duration_minutes','capacity','display_order','rating'].includes(field)?'number':field==='password'?'password':'text'; %><input class="form-control" type="<%= type %>" name="<%= field %>" value="<%= type==='datetime-local'&&value?String(value).replace(' ','T').slice(0,16):value %>" <%= ['title','name','full_name','phone','business_name','setting_key','price_usd','price_lbp'].includes(field)?'required':'' %> <%= type==='number'?'step="any"':'' %> <%= field==='setting_key'&&item?'readonly':'' %>><% } %></div><% }) %><% if(config.image){ %><div class="col-md-6"><label class="form-label">Image</label><input class="form-control" type="file" name="image" accept="image/jpeg,image/png,image/webp" <%= config.requiredImage&&!item?'required':'' %>></div><% } %><% (config.images||[]).forEach(name=>{ %><div class="col-md-6"><label class="form-label text-capitalize"><%= name.replace('_',' ') %></label><input class="form-control" type="file" name="<%= name %>" accept="image/jpeg,image/png,image/webp"></div><% }) %></div></div><div class="card-footer d-flex gap-2"><button class="btn btn-primary">Save</button><a class="btn btn-outline-secondary" href="/admin/<%= resource %>">Cancel</a></div></form></div></main></div></div><%- include('../partials/foot') %>
