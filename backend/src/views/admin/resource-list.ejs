<%- include('../partials/head') %><div class="container-fluid"><div class="row"><%- include('../partials/admin-nav') %><main class="col-md-9 col-lg-10 p-0 content-wrap"><%- include('../partials/web-top') %><div class="p-4"><%- include('../partials/alerts') %><div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3 mb-0"><%= config.title %></h1><% if (!config.readonly) { %><a class="btn btn-primary" href="/admin/<%= resource %>/new"><i class="bi bi-plus-lg"></i> New</a><% } %></div><div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>ID</th><% config.fields.filter((f)=>!['password','description','content','setting_value'].includes(f)).slice(0,5).forEach((field)=>{ %><th><%= field.replaceAll('_',' ') %></th><% }) %><th>Created</th><th></th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="8" class="text-center text-muted py-4">No records yet.</td></tr><% } rows.forEach((row)=>{ %><tr><td><%= row.id || row.setting_key %></td><% config.fields.filter((f)=>!['password','description','content','setting_value'].includes(f)).slice(0,5).forEach((field)=>{ %><td><%= row[field] ?? '—' %></td><% }) %><td><%= row.created_at || row.updated_at || '—' %></td><td class="text-end"><% if(resource==='bookings'){ %><form class="d-inline" method="post" action="/admin/bookings/<%= row.id %>/action"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="confirm"><button class="btn btn-sm btn-success" <%= row.status!=='PENDING'?'disabled':'' %>>Confirm</button></form><form class="d-inline" method="post" action="/admin/bookings/<%= row.id %>/action"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="cancel"><button class="btn btn-sm btn-outline-danger" <%= row.status==='CANCELLED'?'disabled':'' %>>Cancel</button></form><% } else if(resource==='qr-codes'){ %><form class="d-inline" method="post" action="/admin/qr-codes/<%= row.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-danger" <%= row.status!=='ACTIVE'?'disabled':'' %>>Cancel</button></form><% } else if(!config.readonly){ %><a class="btn btn-sm btn-outline-primary" href="/admin/<%= resource %>/<%= row.id || row.setting_key %>/edit">Edit</a><% if(!config.settings){ %><form class="d-inline" method="post" action="/admin/<%= resource %>/<%= row.id %>/delete" data-confirm="Delete this record?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-danger">Delete</button></form><% } %><% } %></td></tr><% }) %></tbody></table></div></div></div></main></div></div><script src="/js/provider.js"></script><%- include('../partials/foot') %>
