<%- include('../partials/head') %><div class="container-fluid"><div class="row"><%- include('../partials/provider-nav') %><main class="col-md-9 col-lg-10 p-0 content-wrap"><%- include('../partials/web-top') %><div class="p-4"><h1 class="h3 mb-3">Bookings</h1><div class="card shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Code</th><th>Offering</th><th>Scheduled</th><th>Status</th><th></th></tr></thead><tbody><% if(!rows.length){%><tr><td colspan="5" class="text-center text-muted py-4">No bookings yet.</td></tr><%} rows.forEach(row=>{%><tr><td><%= row.booking_code %></td><td><%= row.offering_title %></td><td><%= row.scheduled_at %></td><td><span class="badge text-bg-secondary"><%= row.status %></span></td><td><a class="btn btn-sm btn-outline-primary" href="/provider/bookings/<%= row.id %>">View</a></td></tr><%})%></tbody></table></div></div></div></main></div></div><%- include('../partials/foot') %>
