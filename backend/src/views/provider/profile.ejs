<%- include('../partials/head') %><div class="container-fluid"><div class="row"><%- include('../partials/provider-nav') %><main class="col-md-9 col-lg-10 p-0 content-wrap"><%- include('../partials/web-top') %><div class="p-4"><%- include('../partials/alerts') %><h1 class="h3 mb-3">Provider profile</h1><form class="card shadow-sm" method="post" action="/provider/profile"><div class="card-body"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row g-3"><% [['business_name','Business name'],['phone','Phone'],['email','Email'],['address','Address']].forEach(([field,label])=>{%><div class="col-md-6"><label class="form-label"><%= label %></label><input class="form-control" name="<%= field %>" value="<%= provider[field]||'' %>" <%= ['business_name','phone'].includes(field)?'required':'' %>></div><%})%><div class="col-12"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="4"><%= provider.description||'' %></textarea></div></div></div><div class="card-footer"><button class="btn btn-primary">Save profile</button></div></form></div></main></div></div><%- include('../partials/foot') %>
