<%- include('../partials/head') %><div class="container-fluid"><div class="row"><%- include('../partials/provider-nav') %><main class="col-md-9 col-lg-10 p-0 content-wrap"><%- include('../partials/web-top') %><div class="p-4"><h1 class="h3"><%= booking.booking_code %></h1><p class="text-muted"><%= booking.offering_title %> · <%= booking.scheduled_at %></p><div class="card shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Participant</th><th>Phone</th><th>Owner</th><th>QR status</th></tr></thead><tbody><% participants.forEach(p=>{%><tr><td><%= p.full_name %></td><td><%= p.phone %></td><td><%= p.is_owner?'Yes':'No' %></td><td><span class="badge text-bg-secondary"><%= p.qr?.status || '—' %></span></td></tr><%})%></tbody></table></div></div></div></main></div></div><%- include('../partials/foot') %>
