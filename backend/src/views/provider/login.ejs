<%- include('../partials/head') %><main class="container py-5"><div class="card shadow-sm mx-auto" style="max-width:420px"><div class="card-body p-4"><h1 class="h3 brand text-primary">Zeere Provider</h1><p class="text-muted">Sign in to validate booking participants.</p><% if (flash) { %><%- include('../partials/alerts') %><% } %><form method="post" action="/provider/login"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><label class="form-label">Phone</label><input class="form-control" name="phone" required></div><div class="mb-3"><label class="form-label">Password</label><input class="form-control" type="password" name="password" required></div><button class="btn btn-primary w-100">Sign in</button></form><a class="d-block text-center mt-3 small" href="/admin/login">Admin sign in</a></div></div></main><%- include('../partials/foot') %>
