<%- include('../partials/head') %><div class="container-fluid"><div class="row"><%- include('../partials/provider-nav') %><main class="col-md-9 col-lg-10 p-0 content-wrap"><%- include('../partials/web-top') %><div class="p-4"><%- include('../partials/alerts') %><h1 class="h3">Welcome, <%= provider.business_name %></h1><div class="row g-3 mt-1"><% [['Today’s bookings',summary.today],['Upcoming confirmed bookings',summary.upcoming],['Participants today',summary.participants],['Successful validations',summary.ok],['Failed scans',summary.failed]].forEach(([label,value])=>{ %><div class="col-sm-6 col-xl"><div class="card shadow-sm h-100"><div class="card-body"><div class="display-6"><%= value %></div><small class="text-muted"><%= label %></small></div></div></div><% }) %></div><a class="btn btn-primary mt-4" href="/provider/scanner"><i class="bi bi-qr-code-scan me-1"></i>Open scanner</a></div></main></div></div><%- include('../partials/foot') %>
