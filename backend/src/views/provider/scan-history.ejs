<%- include('../partials/head') %><div class="container-fluid"><div class="row"><%- include('../partials/provider-nav') %><main class="col-md-9 col-lg-10 p-0 content-wrap"><%- include('../partials/web-top') %><div class="p-4"><h1 class="h3 mb-3">Scan history</h1><div class="card shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>When</th><th>Result</th><th>Message</th><th>Token</th></tr></thead><tbody><% if(!rows.length){%><tr><td colspan="4" class="text-center text-muted py-4">No scans yet.</td></tr><%}rows.forEach(row=>{%><tr><td><%= row.created_at %></td><td><span class="badge text-bg-<%= row.success?'success':'danger' %>"><%= row.result_code %></span></td><td><%= row.result_message %></td><td class="small text-break"><%= row.public_token || row.provided_token %></td></tr><%})%></tbody></table></div></div></div></main></div></div><%- include('../partials/foot') %>
